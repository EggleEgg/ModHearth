<Window xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="clr-namespace:ModHearth.UI"
  x:Class="ModHearth.UI.SortRulesWindow"
  Title="Sort Rules"
  Width="720"
  Height="800"
  MinWidth="600"
  MinHeight="400">
  <Window.DataTemplates>
    <DataTemplate DataType="ui:ModRefViewModel">
      <Border Background="{Binding BackgroundBrush}" Padding="2,0" MinHeight="20"
        ToolTip.Tip="{Binding HoverTooltip}">
        <Grid>
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="2"
              Background="{Binding CacheBarBrush}"
              IsVisible="{Binding IsCached}"
              ZIndex="2" />
            <TextBlock Grid.Column="1"
              Text="{Binding DisplayName}"
              Foreground="{Binding TextBrush}"
              TextTrimming="CharacterEllipsis"
              FontWeight="Normal"
              TextDecorations="{Binding TextDecorations}"
              Margin="4,0,0,0" />
          </Grid>
          <Border Height="2"
            Background="{Binding DropHighlightBrush}"
            IsVisible="{Binding ShowDropAbove}"
            VerticalAlignment="Top" />
          <Border Height="2"
            Background="{Binding DropHighlightBrush}"
            IsVisible="{Binding ShowDropBelow}"
            VerticalAlignment="Bottom" />
        </Grid>
      </Border>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid Margin="12" RowDefinitions="Auto,*,160" ColumnDefinitions="*,*" ColumnSpacing="12"
    RowSpacing="10">
    <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox x:Name="searchBox" Watermark="Search mods" Height="28" Padding="6,2"
        VerticalContentAlignment="Center" />
      <Button x:Name="saveButton" Grid.Column="1" Content="Save" Width="100" Height="28" />
    </Grid>

    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*" ColumnSpacing="12"
      RowDefinitions="Auto,*">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Mod Tree" FontWeight="Bold" />
      <TextBlock Grid.Row="0" Grid.Column="1" Text="Rules List" FontWeight="Bold" />

      <ListBox x:Name="modTreeList" Grid.Row="1" Grid.Column="0" SelectionMode="Multiple"
        Margin="0,6,0,0">
        <ListBox.ItemContainerTheme>
          <ControlTheme TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="IsVisible" Value="{Binding IsVisible}" />
          </ControlTheme>
        </ListBox.ItemContainerTheme>
      </ListBox>

      <ListBox x:Name="rulesList" Grid.Row="1" Grid.Column="1" SelectionMode="Multiple"
        Margin="0,6,0,0">
        <ListBox.ItemContainerTheme>
          <ControlTheme TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
          </ControlTheme>
        </ListBox.ItemContainerTheme>
      </ListBox>
    </Grid>

    <Grid Grid.Row="2" Grid.Column="1" RowDefinitions="Auto,*">
      <TextBlock Text="Selected Rule Mods" FontWeight="Bold" />
      <ListBox x:Name="selectedRulesList" Grid.Row="1" SelectionMode="Single"
        IsHitTestVisible="False" />
    </Grid>
  </Grid>
</Window>