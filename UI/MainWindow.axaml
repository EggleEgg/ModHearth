<Window xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="clr-namespace:ModHearth.UI"
  x:Class="ModHearth.UI.MainWindow"
  Title="Mod Hearth"
  Width="1264"
  Height="828"
  MinWidth="1020"
  MinHeight="640">
  <Window.DataTemplates>
    <DataTemplate DataType="ui:ModRefViewModel">
      <Border Background="{Binding BackgroundBrush}" Padding="2,0" MinHeight="20"
        HorizontalAlignment="Stretch"
        ToolTip.Tip="{Binding HoverTooltip}">
        <Border.ContextMenu>
          <ContextMenu Opened="ModContextMenuOpened">
            <MenuItem Header="Delete local mod" Tag="delete-mod" Click="ModContextDeleteMod" />
            <MenuItem Header="Unsubscribe from steam" Tag="unsubscribe-steam" IsVisible="False"
              Click="ModContextUnsubscribeSteam" />
            <MenuItem Header="Redownload from steam" Tag="redownload-steam" IsVisible="False"
              Click="ModContextRedownloadSteam" />
            <Separator />
            <MenuItem Header="Open Folder" Tag="open" Click="ModContextOpenFolder" />
            <MenuItem Header="Open Steam Page" Tag="open-steam" IsVisible="False"
              Click="ModContextOpenSteam" />
            <MenuItem Header="Copy Mod ID" Tag="copy-id" Click="ModContextCopyId" />
          </ContextMenu>
        </Border.ContextMenu>
        <Grid>
          <Grid ColumnDefinitions="Auto,Auto,*">
            <Border Width="2"
              Background="{Binding CacheBarBrush}"
              IsVisible="{Binding IsCached}"
              ZIndex="2" />
            <Image Grid.Column="1"
              Source="{ui:AssetImage dwarfIcon}"
              IsVisible="{Binding IsVanillaModSource}"
              Width="14"
              Height="14"
              VerticalAlignment="Center"
              Stretch="Uniform" />
            <Image Grid.Column="1"
              Source="{ui:AssetImage folderIcon}"
              IsVisible="{Binding IsLocalModSource}"
              Width="14"
              Height="14"
              VerticalAlignment="Center"
              Stretch="Uniform" />
            <Image Grid.Column="1"
              Source="{ui:AssetImage steamIcon}"
              IsVisible="{Binding IsSteamModSource}"
              Width="14"
              Height="14"
              VerticalAlignment="Center"
              Stretch="Uniform" />
            <TextBlock Grid.Column="2"
              Text="{Binding DisplayName}"
              Foreground="{Binding TextBrush}"
              TextTrimming="CharacterEllipsis"
              FontWeight="Normal"
              TextDecorations="{Binding TextDecorations}"
              MinWidth="0"
              MaxWidth="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
              Margin="4,0,0,0"
              VerticalAlignment="Center" />
          </Grid>
          <Border Height="2"
            Background="{Binding DropHighlightBrush}"
            IsVisible="{Binding ShowDropAbove}"
            VerticalAlignment="Top" />
          <Border Height="2"
            Background="{Binding DropHighlightBrush}"
            IsVisible="{Binding ShowDropBelow}"
            VerticalAlignment="Bottom" />
        </Grid>
      </Border>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="10*" />
      <ColumnDefinition Width="11*" />
      <ColumnDefinition Width="200" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.Column="0" Margin="3">
      <Grid>
        <Grid RowSpacing="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="modTitleLabel" FontSize="24" FontWeight="Bold"
            TextWrapping="WrapWithOverflow"
            MaxWidth="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=Border}}"
            VerticalAlignment="Center" MinHeight="42" Margin="2,2,2,5" />
          <Border Grid.Row="1" Background="Transparent" Margin="2">
            <Image x:Name="modPreviewImage" Stretch="Uniform" HorizontalAlignment="Center"
              VerticalAlignment="Center" MaxWidth="600" MaxHeight="600" Margin="10,0,10,0" />
          </Border>
          <ScrollViewer Grid.Row="2" Margin="2,12,2,2" VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="modDescriptionLabel" TextWrapping="WrapWithOverflow" />
          </ScrollViewer>
          <Grid Grid.Row="3" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
            VerticalAlignment="Center" Margin="0,5,2,0" MinHeight="18" RowSpacing="7">
            <Border x:Name="modInfoTopBorder" Grid.Row="0" Grid.ColumnSpan="2" Height="2"
              HorizontalAlignment="Stretch" Margin="2,0,0,0" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button x:Name="updateButton" Width="23" Height="23" Padding="0"
                ToolTip.Tip="Check for updates">
                <Image Source="{ui:AssetImage updateIcon}"
                  Stretch="Uniform" />
              </Button>
              <TextBlock x:Name="modVersionLabel" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="dfhackStatusLabel" Grid.Row="1" Grid.Column="1" FontSize="11"
              Margin="0,5,0,0"
              HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="False" />
          </Grid>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Column="1" Margin="3">
      <Grid RowDefinitions="22,30,*" ColumnDefinitions="*,*" ColumnSpacing="0" RowSpacing="0">
        <TextBlock x:Name="leftHeaderLabel" Grid.Row="0" Grid.Column="0"
          HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock x:Name="rightHeaderLabel" Grid.Row="0" Grid.Column="1"
          HorizontalAlignment="Center" VerticalAlignment="Center" />

        <ui:ModSearchBar x:Name="leftSearchBar" Grid.Row="1" Grid.Column="0" Margin="0,0,10,0"
          Watermark="Search" Height="30" />
        <ui:ModSearchBar x:Name="rightSearchBar" Grid.Row="1" Grid.Column="1" Margin="0,0,10,0"
          Watermark="Search" Height="30" />

        <ListBox x:Name="leftModlist" Grid.Row="2" Grid.Column="0" SelectionMode="Multiple"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          Margin="0,6,12,0">
          <ListBox.ItemContainerTheme>
            <ControlTheme TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="IsVisible" Value="{Binding IsVisible}" />
            </ControlTheme>
          </ListBox.ItemContainerTheme>
        </ListBox>
        <ListBox x:Name="rightModlist" Grid.Row="2" Grid.Column="1" SelectionMode="Multiple"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          Margin="0,6,12,0">
          <ListBox.ItemContainerTheme>
            <ControlTheme TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="IsVisible" Value="{Binding IsVisible}" />
            </ControlTheme>
          </ListBox.ItemContainerTheme>
        </ListBox>
      </Grid>
    </Border>

    <Border Grid.Column="2" Margin="0,3,3,3">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="6">
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
          <Button x:Name="saveButton" Height="42" Padding="0" HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center" ToolTip.Tip="Save the current modlist">
            <Image Source="{ui:AssetImage saveIcon}" />
          </Button>
          <Button x:Name="undoChangesButton" Grid.Column="1" Height="42" Padding="0"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
            ToolTip.Tip="Undo unsaved changes">
            <Image Source="{ui:AssetImage undoIcon}" />
          </Button>
          <Button x:Name="clearInstalledModsButton" Grid.Column="2" Height="42" Padding="0"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
            ToolTip.Tip="Clear the installed mods cache. Right click to open the installed_mods folder">
            <Image Source="{ui:AssetImage trashIcon}" />
          </Button>
          <Button x:Name="reloadButton" Grid.Column="3" Height="42" Padding="0"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
            ToolTip.Tip="Reload modlists from disk. Right click to autoreload">
            <Image Source="{ui:AssetImage reloadIcon}" />
          </Button>
        </Grid>

        <ComboBox x:Name="modpackComboBox" Grid.Row="2" Height="30" HorizontalAlignment="Stretch" />

        <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="6">
          <Button x:Name="newListButton" Content="New" FontSize="12" Height="28"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button x:Name="renameListButton" Grid.Column="1" Content="Rename" FontSize="12"
            Height="28" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button x:Name="deleteListButton" Grid.Column="2" Content="Delete" FontSize="12"
            Height="28" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </Grid>

        <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="6">
          <Button x:Name="importButton" Content="Import" FontSize="13" Height="28"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center" />
          <Button x:Name="exportButton" Grid.Column="1" Content="Export" FontSize="13" Height="28"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </Grid>

        <Grid Grid.Row="5" ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <Button x:Name="autoSortButton" Content="Auto Sort" Height="28"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button x:Name="sortRulesButton" Grid.Column="1" Width="28" Height="28" Padding="0"
            ToolTip.Tip="Custom sorting rules. These override automatic sorting">
            <Image Source="{ui:AssetImage gearIcon}"
              Stretch="Uniform" />
          </Button>
        </Grid>

        <Button x:Name="updateLogButton" Grid.Row="6" Content="Update log" Height="28"
          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
          VerticalAlignment="Bottom" Margin="0,0,0,6" FontSize="13" />

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button x:Name="warningIssuesButton" Width="60" Height="60" Padding="0" IsVisible="False"
            IsEnabled="False" HorizontalAlignment="Left" VerticalAlignment="Center"
            ToolTip.Tip="Issues detected in mods">
            <Image x:Name="warningIssuesIcon"
              Source="{ui:AssetImage errorIcon}" Stretch="Uniform" />
          </Button>
          <StackPanel Spacing="6" HorizontalAlignment="Right">
            <ComboBox x:Name="themeComboBox" Width="130" Height="30" />
            <Button x:Name="redoConfigButton" Content="Redo Config" FontSize="12" Height="30"
              HorizontalAlignment="Right" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>