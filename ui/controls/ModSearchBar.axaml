<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ModHearth.UI"
             x:Class="ModHearth.UI.ModSearchBar"
             x:DataType="ui:ModSearchBar">
  <UserControl.Resources>
    <ui:SearchFilterModeToVisibilityConverter x:Key="SearchFilterModeToVisibilityConverter" />
  </UserControl.Resources>

  <Border x:Name="SearchBorder" CornerRadius="6" BorderThickness="1" ClipToBounds="True">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
      <TextBox x:Name="SearchBox" Grid.Column="0" BorderThickness="0" Background="Transparent"
               Margin="1,0,0,0" Padding="4,0,4,1" VerticalContentAlignment="Center" MinHeight="0" Height="28"
               IsVisible="{Binding $parent[ui:ModSearchBar].SearchMode, Converter={StaticResource SearchFilterModeToVisibilityConverter}, ConverterParameter=!Color}"/>
      <ui:ModColorPicker x:Name="ColorPicker" Grid.Column="0" IsVisible="{Binding $parent[ui:ModSearchBar].SearchMode, Converter={StaticResource SearchFilterModeToVisibilityConverter}, ConverterParameter=Color}"/>
      <Button x:Name="SearchModeButton" Grid.Column="1" Height="22" Padding="-1"
              Margin="0,2,2,2" VerticalAlignment="Center">
        <Panel>
          <Image x:Name="SearchModeIcon" Width="15" Height="15"
                 Stretch="Uniform"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"/>

          <Border x:Name="SortDirectionBorder"
            Width="13" Height="13"
            CornerRadius="0.5"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            Margin="0,0,2,0"
            Background="{Binding #SearchModeButton.Background}"
            IsVisible="{Binding $parent[ui:ModSearchBar].IsSortingEnabled}">
            <Image
              x:Name="SortDirectionIcon"
              Source="{ui:AssetImage sortDownIcon}"
              Width="11" Height="11"/>
          </Border>

        </Panel>
      </Button>
      <Button x:Name="ToggleButton" Grid.Column="2" Width="22" Height="22" Padding="-1"
              Margin="0,2,2,2" VerticalAlignment="Center">
        <Image x:Name="ToggleIcon"
               Source="{ui:AssetImage viewEyeIcon}" />
      </Button>
      <Button x:Name="ClearButton" Grid.Column="3" Width="22" Height="22" Padding="0"
              Margin="0,2,2.5,2" VerticalAlignment="Center">
        <Image Source="{ui:AssetImage cancelIcon}" />
      </Button>
    </Grid>
  </Border>
</UserControl>
