<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ModHearth.UI"
             x:Class="ModHearth.UI.ModRefControl"
             x:Name="Root"
             x:DataType="ui:ModRefViewModel"
             Background="{Binding BackgroundBrush}"
             MinHeight="20">
  <UserControl.ContextMenu>
    <ContextMenu Opened="OnContextMenuOpened">
      <MenuItem Header="Add required mod" Tag="add-required-root" />
      <MenuItem Header="Delete local mod" Tag="delete-mod" Click="OnContextMenuItemClick" />
      <MenuItem Header="Unsubscribe from steam" Tag="unsubscribe-steam" IsVisible="False" Click="OnContextMenuItemClick" />
      <MenuItem Header="Redownload from steam" Tag="redownload-steam" IsVisible="False" Click="OnContextMenuItemClick" />
      <Separator Tag="separator-1" />
      <MenuItem Header="Open Folder" Tag="open" Click="OnContextMenuItemClick" />
      <MenuItem Header="Open Steam Page (browser)" Tag="open-steam" IsVisible="False" Click="OnContextMenuItemClick" />
      <MenuItem Header="Copy Mod ID" Tag="copy-id" Click="OnContextMenuItemClick" />
      <MenuItem Header="Set Mod Color" Tag="set-mod-color-root" />
    </ContextMenu>
  </UserControl.ContextMenu>
  <Grid IsHitTestVisible="False">


    <!--45º diagonal pattern -->
    <!--
    Line Thickness = StrokeThickness
    Line Spacing (Density) = SourceRect, DestinationRect, Canvas: Width, Height.
    Example for tighter spacing (10x10 tile, width & height: 10.5): Lines go from 0,5.5 to 5.5,0 and 5,10.5 to 10.5,5.
    For wider spacing just increase the numbers. 0.5 is used as margin to fully connect the lines
    -->
    <!-- TODO consider using a lighter svg-based approach -->
    <Grid IsHitTestVisible="False" IsVisible="{Binding $parent[ui:ModRefControl].ShowColorUnderlay}">
      <Border Grid.Column="1">
        <Border.Background>
          <VisualBrush TileMode="Tile"
                       SourceRect="0,0,5,5"
                       DestinationRect="0,0,5,5">
            <VisualBrush.Visual>
              <Canvas Width="6" Height="6" Background="Transparent">
                <Line StartPoint="0,3.5" EndPoint="3.5,0"
                      Stroke="{Binding #Root.((ui:ModRefViewModel)DataContext).ColorUnderlayBrush}"
                      StrokeThickness="1.2" />
                <Line StartPoint="2.5,6" EndPoint="6,2.5"
                      Stroke="{Binding #Root.((ui:ModRefViewModel)DataContext).ColorUnderlayBrush}"
                      StrokeThickness="1.2" />
              </Canvas>
            </VisualBrush.Visual>
          </VisualBrush>
        </Border.Background>
      </Border>
    </Grid>

    <Grid ColumnDefinitions="Auto,Auto,*" Margin="2,0,5,0">

      <Grid.Styles>
        <Style Selector="Image">
          <Setter Property="Margin" Value="0,0,4,0" />
          <Setter Property="Width" Value="14" />
          <Setter Property="Height" Value="14" />
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="Stretch" Value="Uniform" />
          <Setter Property="Grid.Column" Value="1" />
        </Style>
      </Grid.Styles>

      <Border Width="2"
              Background="{Binding CacheBarBrush}"
              IsVisible="{Binding IsCached}"
              ZIndex="2" />
      <Image
        Source="{ui:AssetImage dwarfIcon}"
        IsVisible="{Binding IsVanillaModSource}"/>
      <Image
        Source="{ui:AssetImage folderIcon}"
        IsVisible="{Binding IsLocalModSource}"/>
      <Image
        Source="{ui:AssetImage steamIcon}"
        IsVisible="{Binding IsSteamModSource}"/>

      <TextBlock Grid.Column="2"
                 Text="{Binding DisplayName}"
                 Foreground="{Binding TextBrush}"
                 TextTrimming="CharacterEllipsis"
                 FontWeight="Normal"
                 TextDecorations="{Binding TextDecorations}"
                 MinWidth="0"
                 Margin="4,0,0,0"
                 VerticalAlignment="Center" >
        <TextBlock.Effect>
          <DropShadowEffect OffsetX="1"
                            OffsetY="1"
                            BlurRadius="5"
                            Color="Black"
                            Opacity="0.5" />
        </TextBlock.Effect>
      </TextBlock>
    </Grid>
    <Border Height="2"
            Background="{Binding DropHighlightBrush}"
            IsVisible="{Binding ShowDropAbove}"
            VerticalAlignment="Top" />
    <Border Height="2"
            Background="{Binding DropHighlightBrush}"
            IsVisible="{Binding ShowDropBelow}"
            VerticalAlignment="Bottom" />
  </Grid>
</UserControl>
