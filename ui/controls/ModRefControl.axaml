<!--Generic avalonia axaml context and list ui controller to avoid duplicate logic -->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ModHearth.UI"
             x:Class="ModHearth.UI.ModRefControl"
             x:Name="Root"
             x:DataType="ui:ModRefViewModel"
             Background="{Binding BackgroundBrush}"
             MinHeight="20">
  <UserControl.ContextMenu>
    <ContextMenu Opened="OnContextMenuOpened">
      <MenuItem Header="Add required mod" Tag="add-required-root" />
      <MenuItem Header="Delete local mod" Tag="delete-mod" Click="OnContextMenuItemClick" />
      <MenuItem Header="Unsubscribe from steam" Tag="unsubscribe-steam" IsVisible="False" Click="OnContextMenuItemClick" />
      <MenuItem Header="Redownload from steam" Tag="redownload-steam" IsVisible="False" Click="OnContextMenuItemClick" />
      <Separator Tag="separator-1" />
      <MenuItem Header="Open Folder" Tag="open" Click="OnContextMenuItemClick" />
      <MenuItem Tag="open-steam" Classes="remove-arrow-row" IsEnabled="False" Click="OnContextMenuItemClick">
        <MenuItem.Header>
          <TextBlock x:Name="OpenSteamText" Text="Open Steam Page (browser)" VerticalAlignment="Center" />
        </MenuItem.Header>
        <MenuItem.Icon>
          <CheckBox x:Name="OpenSteamInClientCheckBox" Grid.Column="1" IsChecked="{Binding $parent[ui:MainWindow].IsOpenSteamInClientEnabled, FallbackValue=False}" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Tag="copy-id" Classes="remove-arrow-row" Click="OnContextMenuItemClick">
        <MenuItem.Header>
          <TextBlock x:Name="CopyIdText" Text="Copy Mod ID" VerticalAlignment="Center" />
        </MenuItem.Header>
        <MenuItem.Icon>
          <CheckBox x:Name="CopySteamFileIdCheckBox" Grid.Column="1" IsChecked="{Binding $parent[ui:MainWindow].IsCopySteamFileIdEnabled, FallbackValue=False}" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Set Mod Color" Tag="set-mod-color-root" />
    </ContextMenu>
  </UserControl.ContextMenu>
  <Grid IsHitTestVisible="False">

    <Grid IsHitTestVisible="False" IsVisible="{Binding $parent[ui:ModRefControl].ShowColorUnderlay}">
      <ui:ModBackground Grid.Column="1"
                        UnderlayBrush="{Binding #Root.((ui:ModRefViewModel)DataContext).ColorUnderlayBrush}" />
    </Grid>

    <Grid ColumnDefinitions="Auto,Auto,*" Margin="2,0,5,0">

      <Grid.Styles>
        <Style Selector="Image">
          <Setter Property="Margin" Value="0,0,4,0" />
          <Setter Property="Width" Value="14" />
          <Setter Property="Height" Value="14" />
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="Stretch" Value="Uniform" />
          <Setter Property="Grid.Column" Value="1" />
        </Style>
      </Grid.Styles>

      <Border Width="2"
              Background="{Binding CacheBarBrush}"
              IsVisible="{Binding IsCached}"
              ZIndex="2" />
      <Image
        Source="{ui:AssetImage dwarfIcon}"
        IsVisible="{Binding IsVanillaModSource}"/>
      <Image
        Source="{ui:AssetImage folderIcon}"
        IsVisible="{Binding IsLocalModSource}"/>
      <Image
        Source="{ui:AssetImage steamIcon}"
        IsVisible="{Binding IsSteamModSource}"/>

      <TextBlock Grid.Column="2"
                 Text="{Binding DisplayName}"
                 Foreground="{Binding TextBrush}"
                 TextTrimming="CharacterEllipsis"
                 FontWeight="Normal" TextDecorations="{Binding TextDecorations}"
                 MinWidth="0" Margin="4,0,0,0"
                 VerticalAlignment="Center"
                 Classes.has-shadow="{Binding HasColorUnderlay}">

        <TextBlock.Styles>
          <Style Selector="TextBlock.has-shadow">
            <Setter Property="Effect">
              <DropShadowEffect OffsetX="1" OffsetY="1"
                                BlurRadius="5"
                                Color="Black"
                                Opacity="0.8" />
            </Setter>
          </Style>
        </TextBlock.Styles>

      </TextBlock>
    </Grid>
    <Border Height="2"
            Background="{Binding DropHighlightBrush}"
            IsVisible="{Binding ShowDropAbove}"
            VerticalAlignment="Top" />
    <Border Height="2"
            Background="{Binding DropHighlightBrush}"
            IsVisible="{Binding ShowDropBelow}"
            VerticalAlignment="Bottom" />
  </Grid>
</UserControl>
