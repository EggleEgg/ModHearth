<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:modinfodockcontrol="using:ModHearth.UI.Controls.ModInfoDockControl"
             x:Class="ModHearth.UI.ModPreviewPanelView"
             x:DataType="modinfodockcontrol:ModPreviewPanelViewModel">
       <Image Source="{Binding PreviewImage}"
              Stretch="Uniform"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="10,4,10,4" />
</UserControl>