<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:modinfodockcontrol="using:ModHearth.UI.Controls.ModInfoDockControl"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:html="clr-namespace:TheArtOfDev.HtmlRenderer.Avalonia;assembly=Avalonia.HtmlRenderer"
    x:Class="ModHearth.UI.ModDescriptionPanelView"
    x:DataType="modinfodockcontrol:ModDescriptionPanelViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <html:HtmlPanel Text="{Binding DescriptionHtml}" />
    </ScrollViewer>
</UserControl>
