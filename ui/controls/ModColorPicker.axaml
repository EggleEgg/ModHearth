<!-- Specifically used for the "search by color" filter in ModSearchBar -->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ModHearth.UI"
             xmlns:models="clr-namespace:ModHearth.Models"
             x:Class="ModHearth.UI.ModColorPicker"
             x:Name="root">
  <UserControl.Styles>
    <Style Selector="Border.color-swatch">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </UserControl.Styles>

  <Border Background="Transparent" Tapped="Picker_Tapped">
    <Grid ColumnDefinitions="*,Auto">
      <ScrollViewer Name="ColorScrollViewer"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    AllowAutoHide="False">

        <ScrollViewer.Styles>
          <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="5"/>
            <Setter Property="MinHeight" Value="5"/>
            <Setter Property="MaxHeight" Value="5"/>
            <Setter Property="ClipToBounds" Value="True"/>
          </Style>
        </ScrollViewer.Styles>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ItemsControl ItemsSource="{Binding #root.AvailableColors}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:ModColorInfo">
                <Border Classes="color-swatch"
                        BorderBrush="{Binding #root.BorderBrush}"
                        Background="{Binding Brush}"
                        Tapped="Color_Tapped"
                        ToolTip.Tip="{Binding Name}">
                  <Image IsVisible="{Binding IsSelected}" Source="{ui:AssetImage cancelBorderIcon}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3"/>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <Button x:Name="OpenColorPickerButton" Grid.Column="1"
              Command="{Binding #root.OpenColorPickerCommand}"
              VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
              Margin="4,2,0,2" Width="22" Height="22" BorderThickness="0" Padding="0"
              IsVisible="{Binding #root.HasSelectedColors}"
              ToolTip.Tip="Open the color selection menu" >
        <Image Source="{ui:AssetImage grid2x2Icon}"/>
      </Button>
    </Grid>
  </Border>
</UserControl>
