<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ModHearth.UI"
        x:Class="ModHearth.UI.ModUpdateLogWindow"
        Title="Mod Update Log"
        Width="{x:Static ui:ModUpdateLogWindow.DefaultWidth}"
        Height="{x:Static ui:ModUpdateLogWindow.DefaultHeight}"
        MinWidth="{x:Static ui:ModUpdateLogWindow.DefaultMinWidth}"
        MinHeight="{x:Static ui:ModUpdateLogWindow.DefaultMinHeight}">
  <ui:ModUpdateLogControl x:Name="LogControl" />
</Window>