<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ModHearth.UI"
        x:Class="ModHearth.UI.ModUpdateLogWindow"
        x:DataType="ui:ModUpdateLogWindow"
        Title="Mod Update Log"
        Width="980"
        Height="560"
        MinWidth="820"
        MinHeight="480">

  <Grid Margin="12" RowDefinitions="Auto,*">
    <ui:ModRefControl x:Name="ContextMenuHost" IsVisible="False" AllowColorEditing="False" />
    <DataGrid x:Name="logList" Grid.Row="1"
              ItemsSource="{Binding Entries}"
              CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True"
              IsReadOnly="True" GridLinesVisibility="None" LoadingRow="LogListLoadingRow">
      <DataGrid.Styles>
        <Style Selector="DataGridRow:selected /template/ Rectangle">
          <Setter Property="Fill" Value="Transparent" />
        </Style>
        <Style Selector="DataGridCell TextBlock" x:DataType="ui:ModUpdateLogItemViewModel">
          <Setter Property="Foreground" Value="{Binding RowBrush}" />
        </Style>
      </DataGrid.Styles>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="160" />
        <DataGridTextColumn Header="Mod" Binding="{Binding ModName}" Width="220" />
        <DataGridTextColumn Header="Type" Binding="{Binding SourceType}" Width="120" />
        <DataGridTextColumn Header="State" Binding="{Binding StateText}" SortMemberPath="StateSortRank" Width="120" />
        <DataGridTextColumn Header="Active" Binding="{Binding ActiveText}" Width="80" />
        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>

  </Grid>
</Window>