<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ModHearth.UI"
        x:Class="ModHearth.UI.SortRulesWindow"
        Title="Sort Rules"
        Width="980"
        Height="760"
        MinWidth="760"
        MinHeight="520">
  <Window.DataTemplates>
    <DataTemplate DataType="ui:ModRefViewModel">
      <ui:ModRefControl ShowColorUnderlay="True"
                        ShowDetailedRuleBadges="True"
                        AllowRelationshipEditing="True"
                        AllowContextActions="False"
                        AllowColorEditing="False"
                        AllowSeparators="False"
                        Margin="0"
                        Padding="2,0"
                        ToolTip.Tip="{Binding HoverTooltip}" />
    </DataTemplate>
  </Window.DataTemplates>

  <Grid x:Name="MainGrid" Margin="12" ColumnSpacing="4" SizeChanged="OnMainGridSizeChanged">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320" MinWidth="200" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" MinWidth="400" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="8">
      <TextBlock Text="Mods" FontWeight="Bold" />
      <ui:ModSearchBar x:Name="modSearchBar"
                       Grid.Row="1"
                       IsSortingEnabled="True"
                       HideFiltered="True" />

      <ListBox x:Name="modTreeList"
               Grid.Row="2"
               SelectionMode="Single"
               AutoScrollToSelectedItem="False">
        <ListBox.ItemContainerTheme>
          <ControlTheme TargetType="ListBoxItem" x:DataType="ui:ModRefViewModel">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
          </ControlTheme>
        </ListBox.ItemContainerTheme>
      </ListBox>
    </Grid>

    <Border Grid.Column="1" Background="{DynamicResource SeparatorBrush}" Width="0.5"
            HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0" />
    <GridSplitter Grid.Column="1" Width="7" Background="Transparent" ResizeBehavior="PreviousAndNext"
                  HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,0,2,0" />

    <ScrollViewer Grid.Column="2">
      <StackPanel x:Name="editorPanel" Spacing="10">
        <TextBlock x:Name="selectedTitleText" FontSize="18" FontWeight="Bold" />
        <TextBlock x:Name="selectedSubtitleText" FontSize="12" Opacity="0.7" />

        <Border BorderThickness="1" CornerRadius="6"
                Padding="10" Margin="0,4,0,0">
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,*" HorizontalAlignment="Stretch">
              <TextBlock Text="Relationships" FontWeight="Bold" />
              <Button x:Name="clearAllRelationshipsButton" Grid.Column="1"
                      Content="Clear all relationships" Padding="10,4" VerticalAlignment="Center"
                      HorizontalAlignment="Right" HorizontalContentAlignment="Center" FontWeight="Bold"/>
            </Grid>
            <TextBlock x:Name="summaryText" />
            <TextBlock x:Name="validationText" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <StackPanel x:Name="sectionsPanel" Spacing="10" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>