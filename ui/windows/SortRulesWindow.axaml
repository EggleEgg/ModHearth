<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ModHearth.UI"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        x:Class="ModHearth.UI.SortRulesWindow"
        Title="Sort Rules"
        Width="720"
        Height="800"
        MinWidth="600"
        MinHeight="400">
  <Window.DataTemplates>
    <DataTemplate DataType="ui:ModRefViewModel">
      <ui:ModRefControl ShowColorUnderlay="True" Margin="{Binding RuleGapMargin}" Padding="2,0" ToolTip.Tip="{Binding HoverTooltip}" />
    </DataTemplate>
    <DataTemplate DataType="ui:RuleGapMarker">
      <Grid MinHeight="16">
        <Border Background="{Binding LineBrush}" Height="2" VerticalAlignment="Center" Margin="4,0" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="sys:String">
      <Border Padding="4,0" MinHeight="8">
        <TextBlock Text="{Binding}" />
      </Border>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid Margin="12" RowDefinitions="Auto,*,160,Auto" ColumnDefinitions="*,*" ColumnSpacing="12"
        RowSpacing="10">
    <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,*,Auto" ColumnSpacing="8">

      <ui:ModSearchBar x:Name="modTreeSearchBar" PlaceholderText="Search mods" />
      <ui:ModSearchBar x:Name="rulesSearchBar" Grid.Column="1" PlaceholderText="Search rules" IsSortingEnabled="False" />
      <Button x:Name="saveButton" Grid.Column="2" Content="Save" Width="100" Height="28"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
              ToolTip.Tip="Save changes. Right click to open rules file." />
    </Grid>

    <Grid Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" RowDefinitions="Auto,*">
      <TextBlock Text="Mod Tree" FontWeight="Bold" />
      <ListBox x:Name="modTreeList" Grid.Row="1" SelectionMode="Multiple" Margin="0,6,0,0"
               AutoScrollToSelectedItem="False">
        <ListBox.ItemContainerTheme>
          <ControlTheme TargetType="ListBoxItem" x:DataType="ui:ModRefViewModel">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="IsVisible" Value="{Binding IsVisible}" />
          </ControlTheme>
        </ListBox.ItemContainerTheme>
      </ListBox>
    </Grid>

    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*">
      <TextBlock Text="Rules List" FontWeight="Bold" />
      <ListBox x:Name="rulesList" Grid.Row="1" SelectionMode="Multiple" Margin="0,6,0,0"
               Padding="0,0,0,120" AutoScrollToSelectedItem="False">
        <ListBox.ItemContainerTheme>
          <ControlTheme TargetType="ListBoxItem" x:DataType="ui:ModRefViewModel">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="IsVisible" Value="{Binding IsVisible}" />
          </ControlTheme>
        </ListBox.ItemContainerTheme>
      </ListBox>
    </Grid>

    <Grid Grid.Row="2" Grid.Column="1" RowDefinitions="Auto,*">
      <TextBlock Text="Rules JSON" FontWeight="Bold" />
      <ListBox x:Name="selectedRulesList" Grid.Row="1" SelectionMode="Single" />
    </Grid>

    <Grid Grid.Row="3" Grid.ColumnSpan="2" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowSpacing="4" Margin="0,5,0,0">
      <Border Background="{DynamicResource SeparatorBrush}" Grid.Row="0" Grid.ColumnSpan="3" Height="2" HorizontalAlignment="Stretch" Margin="25,0,25,10" />
      <Button x:Name="fetchCommunityRulesButton" Grid.Row="1" Grid.Column="0" Content="Fetch Rules" Margin="0,0,6,0" Height="32"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
      <TextBox x:Name="communityRulesUrlTextBox" Grid.Row="1" Grid.Column="1" PlaceholderText="GitHub repository URL with modsort_rules.json"
               MinHeight="0" Height="28" Padding="8,0" VerticalContentAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
      <TextBlock x:Name="communityRulesStatusTextBlock" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"
                 HorizontalAlignment="Left" Margin="22,0,22,0" Text="Ready" FontSize="12"/>
    </Grid>
  </Grid>
</Window>