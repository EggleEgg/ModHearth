<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ModHearth.UI"
        x:Class="ModHearth.UI.SortRulesWindow"
        Title="Sort Rules"
        Width="{x:Static ui:SortRulesWindow.DefaultWidth}"
        Height="{x:Static ui:SortRulesWindow.DefaultHeight}"
        MinWidth="{x:Static ui:SortRulesWindow.DefaultMinWidth}"
        MinHeight="{x:Static ui:SortRulesWindow.DefaultMinHeight}"
        MaxWidth="{x:Static ui:SortRulesWindow.DefaultMaxWidth}"
        MaxHeight="{x:Static ui:SortRulesWindow.DefaultMaxHeight}">
  <ui:SortRulesControl x:Name="RulesControl" />
</Window>