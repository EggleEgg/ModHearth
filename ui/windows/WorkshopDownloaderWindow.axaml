<!-- Configure any actual ui in WorkshopDownloaderControl.axaml. This file is needed for the window to work -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ModHearth.UI"
        x:Class="ModHearth.UI.WorkshopDownloaderWindow"
        x:DataType="ui:WorkshopDownloaderWindow"
        Width="{x:Static ui:WorkshopDownloaderWindow.DefaultWidth}"
        Height="{x:Static ui:WorkshopDownloaderWindow.DefaultHeight}"
        MinWidth="{x:Static ui:WorkshopDownloaderWindow.DefaultMinWidth}"
        MinHeight="{x:Static ui:WorkshopDownloaderWindow.DefaultMinHeight}"
        MaxWidth="{x:Static ui:WorkshopDownloaderWindow.DefaultMaxWidth}"
        WindowStartupLocation="CenterOwner"
        Title="Steam Workshop Downloader">
  <ui:WorkshopDownloaderControl x:Name="DownloaderControl" />
</Window>
