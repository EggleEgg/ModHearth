<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:ModHearth.UI"
        x:Class="ModHearth.UI.CollectionChecklistDialog"
        Width="550" MinWidth="550" Height="700" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Title="Collection Contents Checklist">
  <Grid RowDefinitions="Auto, *, Auto" Margin="16">
    <!-- Header Controls -->
    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,12">
      <TextBlock Text="Collection Mods" FontSize="18" FontWeight="Bold" />
      <TextBlock Text="Select the mods you wish to download or update:" Opacity="0.7" />
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
        <Button x:Name="BtnDownloadAll" Content="Download All" Padding="12,6" />
        <Button x:Name="BtnClearAll" Content="Clear All" Padding="12,6" />
        <Button x:Name="BtnDownloadMissing" Content="Download Missing" Padding="12,6" />
        <Button x:Name="BtnUpdateExisting" Content="Update Existing" Padding="12,6" />
      </StackPanel>
    </StackPanel>

    <!-- Checklist grid -->
    <Border Grid.Row="1" BorderBrush="{DynamicResource PanelBrush}" BorderThickness="1" CornerRadius="4">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="ItemsList">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ui:CollectionChecklistItem">
              <Border BorderBrush="{DynamicResource PanelBrush}" BorderThickness="0,0,0,1" Padding="10,4">
                <Grid ColumnDefinitions="Auto, *, Auto">
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" Margin="0,0,12,0" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Title}" Grid.Column="1" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <Border Grid.Column="2" Padding="8,4" CornerRadius="4" VerticalAlignment="Center" Background="{Binding ClassificationBrush}">
                    <TextBlock Text="{Binding ClassificationText}" FontSize="11" FontWeight="Bold" Tag="IgnoreTheme" />
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Footer buttons -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button x:Name="BtnConfirm" Content="Import Checked" Classes="accent" Tag="Themed" Padding="16,5" IsDefault="True" />
      <Button x:Name="BtnCancel" Content="Cancel" Padding="16,5" Tag="Themed" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
