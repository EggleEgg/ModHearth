<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:ModHearth.UI"
        x:Class="ModHearth.UI.CollectionChecklistDialog"
        Width="650" Height="500"
        WindowStartupLocation="CenterOwner"
        Title="Collection Contents Checklist">
  <Grid RowDefinitions="Auto, *, Auto" Margin="16">
    <!-- Header Controls -->
    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,12">
      <TextBlock Text="Collection Mods" FontSize="18" FontWeight="Bold" />
      <TextBlock Text="Select the mods you wish to download or update:" Foreground="Gray" />
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
        <Button x:Name="BtnDownloadAll" Content="Download All" Padding="12,6" />
        <Button x:Name="BtnDownloadMissing" Content="Download Missing" Padding="12,6" />
        <Button x:Name="BtnUpdateExisting" Content="Update Existing" Padding="12,6" />
        <Button x:Name="BtnClearAll" Content="Clear All" Padding="12,6" />
      </StackPanel>
    </StackPanel>

    <!-- Checklist grid -->
    <Border Grid.Row="1" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="ItemsList">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ui:CollectionChecklistItem">
              <Border BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="10">
                <Grid ColumnDefinitions="Auto, *, Auto">
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" Margin="0,0,12,0" VerticalAlignment="Center" />
                  
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Author}" FontSize="12" Foreground="Gray" />
                  </StackPanel>

                  <Border Grid.Column="2" Padding="8,4" CornerRadius="4" VerticalAlignment="Center" Background="{Binding ClassificationBrush}">
                    <TextBlock Text="{Binding ClassificationText}" FontSize="11" Foreground="White" FontWeight="Bold" />
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Footer buttons -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button x:Name="BtnConfirm" Content="Import Checked" Classes="accent" Padding="16,8" IsDefault="True" />
      <Button x:Name="BtnCancel" Content="Cancel" Padding="16,8" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
