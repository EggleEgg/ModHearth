<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ModHearth.UI.ReleaseDownloadDialog"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="Downloading Update">
  <StackPanel Margin="16" Spacing="14">
    <TextBlock x:Name="HeaderText" Text="Downloading ModHearth release..."
               TextWrapping="Wrap" FontWeight="SemiBold" />
    <TextBlock x:Name="SubText" Text="Please wait while the release files are being downloaded."
               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MainTextBrush}" />

    <StackPanel x:Name="ProgressPanel" Spacing="6">
      <ProgressBar x:Name="DownloadProgressBar" IsIndeterminate="True" Height="8" Foreground="{DynamicResource ModRefHighlightBrush}" />
      <TextBlock x:Name="StatusTextBlock" Text="Preparing download..." FontSize="11" TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,14,0,0">
      <Button x:Name="BtnCancel" Content="Cancel" />
    </StackPanel>
  </StackPanel>
</Window>
