<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="ModHearth.UI.Dialogs.SettingsDialog"
    Width="440"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    CanResize="False"
    Title="Settings">
    <StackPanel Margin="16" Spacing="16">
        <StackPanel Spacing="6">
            <TextBlock Text="Interface" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock
                    Grid.Column="0"
                    Text="UI scale"
                    VerticalAlignment="Center" />
                <Slider
                    x:Name="uiScaleSlider"
                    Grid.Column="1"
                    MinWidth="140"
                    Minimum="50"
                    Maximum="200"
                    TickFrequency="5"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="uiScaleValueText"
                    Grid.Column="2"
                    Width="40"
                    TextAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource MainTextBrush}" />
            </Grid>
            <TextBlock
                FontSize="11"
                TextWrapping="Wrap"
                Opacity="0.75"
                Foreground="{DynamicResource MainTextBrush}"
                Text="Scales controls, icons, and text across every window. Changes apply immediately." />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="Backup" FontWeight="SemiBold" />
            <Button
                x:Name="restoreBackupButton"
                Content="Restore Backup"
                Margin="50,4"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />
            <TextBlock
                x:Name="backupInfoText"
                FontSize="11"
                TextWrapping="Wrap"
                Opacity="0.75"
                Foreground="{DynamicResource MainTextBrush}" />
        </StackPanel>

        <StackPanel Spacing="6">
            <Button
                x:Name="backupNowButton"
                Content="Backup Now"
                Margin="50,4"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />
            <TextBlock
                x:Name="statusText"
                FontSize="11"
                HorizontalAlignment="Stretch"
                TextWrapping="Wrap"
                IsVisible="False"
                Foreground="{DynamicResource MainTextBrush}" />
        </StackPanel>

        <Button
            x:Name="redoConfigButton"
            Content="Redo Config"
            Tag="Themed"
            HorizontalAlignment="Right"
            Padding="10,4" />
    </StackPanel>
</Window>
