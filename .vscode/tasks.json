{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "linuxBuildVersion",
      "type": "promptString",
      "description": "Version string to embed (InformationalVersion)",
      "default": "local-dev"
    },
    {
      "id": "rid",
      "type": "pickString",
      "description": "Select target runtime",
      "options": [
        "win-x64",
        "linux-x64",
      ],
      "default": "win-x64"
    }
  ],
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/ModHearth.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}/ModHearth.csproj",
        "-c",
        "Release",
        "-r",
        "${input:rid}",
        "--self-contained",
        "false",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "group": {
        "kind": "build"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet clean & restore",
      "type": "shell",
      "command": "dotnet clean \"${workspaceFolder}/ModHearth.csproj\" && dotnet restore \"${workspaceFolder}/ModHearth.csproj\"",
      "problemMatcher": []
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/ModHearth.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/ModHearth.csproj"
      ],
      "problemMatcher": "$msCompile",
      "dependsOn": "build"
    },
    {
      "label": "run --dev",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/ModHearth.csproj",
        "--devmode"
      ],
      "problemMatcher": "$msCompile",
      "dependsOn": "build"
    },
    {
      "label": "clean releases",
      "command": "powershell",
      "type": "process",
      "args": [
        "-NoProfile",
        "-Command",
        "$ErrorActionPreference='Stop'; $dirs = @('bin\\Debug','bin\\Release','artifacts'); foreach ($dir in $dirs) { if (Test-Path $dir) { Remove-Item -Path $dir -Recurse -Force } }"
      ],
      "problemMatcher": [
        "$esbuild-watch"
      ],
      "isBackground": true
    },
    {
      "label": "build linux release (WSL)",
      "type": "process",
      "command": "wsl.exe",
      "args": [
        "--cd",
        "${workspaceFolder}",
        "bash",
        ".vscode/build-linux-local.sh",
        "--version",
        "${input:linuxBuildVersion}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "build linux release (WSL, skip tests)",
      "type": "process",
      "command": "wsl.exe",
      "args": [
        "--cd",
        "${workspaceFolder}",
        "bash",
        ".vscode/build-linux-local.sh",
        "--version",
        "${input:linuxBuildVersion}",
        "--skip-tests"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}